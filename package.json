{
  "name": "admin",
  "version": "0.2.8",
  "description": "CMS Admin Panel desktop application",
  "private": true,
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "desktop:prepare": "node desktop/prepare-standalone.mjs",
    "desktop:dev": "npm run build && npm run desktop:prepare && electron .",
    "desktop:dist": "npm run build && npm run desktop:prepare && electron-builder",
    "desktop:dist:win": "npm run build && npm run desktop:prepare && electron-builder --win",
    "desktop:dist:mac": "npm run build && npm run desktop:prepare && electron-builder --mac",
    "desktop:release:win": "npm run build && npm run desktop:prepare && electron-builder --win --publish always",
    "clear-cache": "tsx scripts/clear-electron-cache.ts",
    "diagnose": "tsx scripts/full-diagnostic.ts",
    "check-admin": "tsx scripts/check-admin-status.ts",
    "verify-code": "tsx scripts/verify-complete-code.ts",
    "test-code-library": "tsx scripts/test-code-library.ts",
    "health-check": "node health-check.ts",
    "lint": "eslint",
    "test": "vitest run --config vitest.config.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.102.8",
    "@uiw/react-codemirror": "^4.25.11",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.cms.admin",
    "productName": "CMSAdminPanel",
    "artifactName": "CMS-Admin-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**"
    ],
    "files": [
      "desktop/**/*",
      ".next/standalone/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "CGskills",
      "repo": "cms-admin-releases",
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.svg",
      "executableName": "CMSAdminPanel"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    }
  }
}
